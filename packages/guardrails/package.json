{
  "name": "@lov3kaizen/agentsea-guardrails",
  "version": "1.2.0",
  "description": "TypeScript-native guardrails engine for AI applications. Content safety, prompt injection detection, output validation, and intelligent rate limiting.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "require": "./dist/nestjs/index.js",
      "import": "./dist/nestjs/index.mjs"
    },
    "./agentsea": {
      "types": "./dist/integrations/agentsea/index.d.ts",
      "require": "./dist/integrations/agentsea/index.js",
      "import": "./dist/integrations/agentsea/index.mjs"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain/index.d.ts",
      "require": "./dist/integrations/langchain/index.js",
      "import": "./dist/integrations/langchain/index.mjs"
    },
    "./vercel-ai": {
      "types": "./dist/integrations/vercel-ai/index.d.ts",
      "require": "./dist/integrations/vercel-ai/index.js",
      "import": "./dist/integrations/vercel-ai/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/nestjs/index.ts src/integrations/agentsea/index.ts src/integrations/langchain/index.ts src/integrations/vercel-ai/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/nestjs/index.ts src/integrations/agentsea/index.ts src/integrations/langchain/index.ts src/integrations/vercel-ai/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "pino": "^8.16.0",
    "lru-cache": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "rxjs": "^7.8.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@lov3kaizen/agentsea-core": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@lov3kaizen/agentsea-core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "prom-client": "^15.0.0",
    "@opentelemetry/api": "^1.7.0"
  },
  "keywords": [
    "agentsea",
    "guardrails",
    "ai",
    "safety",
    "content-moderation",
    "prompt-injection",
    "pii-detection",
    "toxicity",
    "validation",
    "rate-limiting",
    "security",
    "llm",
    "claude",
    "anthropic",
    "openai",
    "langchain",
    "vercel-ai",
    "typescript",
    "nodejs",
    "nestjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "lovekaizen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovekaizen/agentsea.git",
    "directory": "packages/guardrails"
  },
  "homepage": "https://agentsea.dev",
  "bugs": {
    "url": "https://github.com/lovekaizen/agentsea/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
