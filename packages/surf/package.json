{
  "name": "@lov3kaizen/agentsea-surf",
  "version": "0.6.0",
  "description": "Surf - Computer-use agent for AgentSea. Control desktop environments through screen capture, mouse, and keyboard actions using Claude's vision capabilities.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "require": "./dist/nestjs/index.js",
      "import": "./dist/nestjs/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/nestjs/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/nestjs/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lov3kaizen/agentsea-core": "workspace:*",
    "@lov3kaizen/agentsea-types": "workspace:*",
    "zod": "^3.22.4",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/websockets": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.0.0",
    "puppeteer-core": "^21.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    },
    "@nestjs/platform-socket.io": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "keywords": [
    "agentsea",
    "surf",
    "ai",
    "agents",
    "computer-use",
    "desktop-automation",
    "screen-capture",
    "mouse-control",
    "keyboard-control",
    "vision",
    "claude",
    "anthropic",
    "puppeteer",
    "automation",
    "rpa",
    "typescript",
    "nodejs",
    "nestjs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "lovekaizen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovekaizen/agentsea.git",
    "directory": "packages/surf"
  },
  "homepage": "https://agentsea.dev",
  "bugs": {
    "url": "https://github.com/lovekaizen/agentsea/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
