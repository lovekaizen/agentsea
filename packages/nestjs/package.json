{
  "name": "@lov3kaizen/agentsea-nestjs",
  "version": "1.2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "NestJS integration for AgentSea - Unite and orchestrate AI agents in your NestJS applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lov3kaizen/agentsea-types": "workspace:*",
    "@lov3kaizen/agentsea-core": "workspace:*",
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/websockets": "^11.1.26",
    "@nestjs/platform-socket.io": "^11.1.26",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "keywords": [
    "agentsea",
    "nestjs",
    "ai",
    "agents",
    "agentic",
    "llm",
    "integration",
    "dependency-injection"
  ],
  "author": "lovekaizen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovekaizen/agentsea.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://agentsea.dev",
  "bugs": {
    "url": "https://github.com/lovekaizen/agentsea/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
