    "nanoid": "^5.0.7",
    "tiktoken": "^1.0.18",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "better-sqlite3": "^11.6.0",
    "eslint": "^9.17.0",
    "pg": "^8.13.1",
    "stripe": "^17.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
