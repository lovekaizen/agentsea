{
  "name": "@lov3kaizen/agentsea-costs",
  "version": "1.0.0",
  "description": "AI cost management platform with real-time tracking, budget enforcement, and optimization",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
