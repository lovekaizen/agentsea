{
  "name": "agentsea",
  "version": "1.2.1",
  "private": true,
  "description": "AgentSea - Production-ready ADK for building agentic AI applications in Node.js",
  "keywords": [
    "agentsea",
    "ai",
    "agents",
    "llm",
    "anthropic",
    "claude",
    "nestjs",
    "orchestration",
    "workflow"
  ],
  "author": "lovekaizen <michael@lovekaizen.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lovekaizen/agentsea.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "lint": "eslint '{packages,examples}/**/*.ts' --fix",
    "format": "prettier --write '{packages,examples}/**/*.{ts,json,md}'",
    "type-check": "pnpm -r run type-check",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "version-lockstep": "node scripts/release-version.mjs",
    "version-lockstep:dry": "node scripts/release-version.mjs --dry-run",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@1": "^1.14.4",
      "@hono/node-server@1": "^1.19.13",
      "@isaacs/brace-expansion@5": "^5.0.1",
      "@opentelemetry/core": "^2.8.0",
      "@protobufjs/utf8": ">=1.1.1",
      "@tootallnate/once": ">=2.0.1",
      "@xmldom/xmldom": "^0.8.13",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "basic-ftp": ">=5.3.1",
      "better-sqlite3": "11.10.0",
      "brace-expansion@1": "^1.1.13",
      "brace-expansion@2": "^2.0.3",
      "esbuild@<0.25.0": ">=0.25.0",
      "esbuild@>=0.27.0 <0.28.1": ">=0.28.1",
      "fast-uri": ">=3.1.2",
      "fast-xml-parser@5": "^5.7.0",
      "file-type@20": "^21.3.2",
      "flatted": ">=3.4.2",
      "follow-redirects": ">=1.16.0",
      "form-data@2": "^2.5.6",
      "form-data@3": "^3.0.5",
      "glob@10": "^10.5.0",
      "handlebars": "^4.7.9",
      "hono@4": "^4.12.21",
      "ip-address": ">=10.1.1",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.2.0",
      "lodash": "^4.18.0",
      "mdast-util-to-hast@13": "^13.2.1",
      "minimatch@10": "^10.2.3",
      "minimatch@3": "^3.1.4",
      "minimatch@5": "^5.1.8",
      "minimatch@7": "^7.4.8",
      "minimatch@9": "^9.0.7",
      "mongoose@8": "^8.22.1",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "protobufjs@7": "^7.5.8",
      "protobufjs@8": "^8.2.0",
      "qs@6": "^6.15.2",
      "rollup@4": "^4.59.0",
      "socket.io-parser@4": "^4.2.6",
      "tar-fs@3": "^3.1.1",
      "underscore": ">=1.13.8",
      "undici@6": "^6.27.0",
      "undici@7": "^7.28.0",
      "uuid": ">=11.1.1",
      "validator": "^13.15.22",
      "vite@<6.4.2": "^6.4.2",
      "ws@8": "^8.20.1",
      "yaml@2": "^2.8.3"
    }
  }
}
